# Serves the static site inside the container on port 80.
# HTTPS is handled by the reverse proxy in front of it on the VPS.
:80 {
	root * /srv
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	@knowledge path /knowledge-site.md
	header @knowledge Cache-Control "no-cache"
}
